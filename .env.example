BRIDGE_PORT=8788
BRIDGE_TOKEN=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8790
EXECUTIVE_REFRESH_INTERVAL_MS=7200000
# Vacío toma el 1 de enero del año actual.
EXECUTIVE_CACHE_FROM=

# Worker local de Ventas. El supervisor combina el .env.local privado del portal
# con .env.bridge; nunca copia ni envía secretos al navegador.
