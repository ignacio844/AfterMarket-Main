    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bridge:start": "node --env-file=.env.bridge bridge/server.mjs",
    "bridge:ventas": "node --env-file=.env.local --env-file=.env.bridge bridge/ventas-sync.mjs",
    "bridge:ventas:dry-run": "node --env-file=.env.local --env-file=.env.bridge bridge/ventas-sync.mjs --dry-run",
